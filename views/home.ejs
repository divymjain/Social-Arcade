<!DOCTYPE html>
<html lang="en">
<%- include('includes/header') %>

  <section class="hero">
    <div class="hero-bg"></div> 
    <div class="hero-text" data-aos="fade-up">
      <h1 class="gradient-text">Welcome to Gamer's Hub</h1>
      <p>Your ultimate destination to explore and enjoy the best of gaming.</p>
      <a href="/register"><button class="cta-button">Join Now</button></a>
    </div>
  </section>

  <section class="trending-slider" data-aos="fade-up">
    <h2>Trending Now</h2>
    <div class="slider-container">
      
      <div class="game-card">
        <img src="/images/game1.jpg" alt="Cyberpunk 2077" />
        <div class="card-content">
          <h3>Cyberpunk 2077</h3>
          <p>Explore a dystopian future with jaw-dropping graphics and deep storytelling.</p>
        </div>
      </div>
  
      <div class="game-card">
        <img src="/images/game2.jpg" alt="Elden Ring" />
        <div class="card-content">
          <h3>Elden Ring</h3>
          <p>A masterpiece of open-world design and intense boss battles.</p>
        </div>
      </div>
  
      <div class="game-card">
        <img src="/images/game3.jpg" alt="Fortnite" />
        <div class="card-content">
          <h3>Fortnite</h3>
          <p>The ever-evolving battle royale that keeps the hype alive.</p>
        </div>
      </div>
  
      <div class="game-card">
        <img src="/images/game4.jpg" alt="Hogwarts Legacy" />
        <div class="card-content">
          <h3>Hogwarts Legacy</h3>
          <p>Live your wizarding fantasy in an immersive magical world.</p>
        </div>
      </div>
  
      
    </div>
  </section>  

  <section class="features">
    <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
      <i class="fas fa-gamepad card-icon"></i>
      <h3>Massive Game Collection</h3>
      <p>Explore trending, classic, and indie games in one place.</p>
    </div>
    <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
      <i class="fas fa-users card-icon"></i>
      <h3>Gaming Community</h3>
      <p>Connect with thousands of gamers, join events, and build your squad.</p>
    </div>
    <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
      <i class="fas fa-shopping-cart card-icon"></i>
      <h3>E-Shop</h3>
      <p>Grab the latest deals on premium and discounted games.</p>
    </div>
    <div class="feature-card" data-aos="fade-up" data-aos-delay="400">
      <i class="fas fa-calendar-alt card-icon"></i>
      <h3>Events & Tournaments</h3>
      <p>Compete and showcase your skills in regular online events.</p>
    </div>
  </section>

  
  <%- include('includes/footer') %>
</body>
</html>
